# ---------------------------------------------------------------- users
show_link() { # USER_JSON
  local name link
  name="$(jq -r '.response.username' <<<"$1")"
  link="$(jq -r '.response.subscriptionUrl' <<<"$1")"
  echo
  echo "Подписка $name. Отправьте ссылку знакомому (лично, не в общий чат):"
  echo
  echo "  $link"
  echo
  echo "Ссылка сразу для Klaus VPN (откроет приложение, если оно установлено):"
  echo
  echo "  klausvpn://add/$link"
  echo
  if command -v qrencode >/dev/null; then
    echo "QR-код (сфотографируйте камерой телефона — откроется страница с кнопками):"
    qrencode -t ANSIUTF8 -m 2 "$link"
  fi
}

cmd_add_user() {
  local name="${1:-}" devices="" body
  [ -n "$name" ] || die "укажите имя: klaus-panel add-user ИМЯ [--devices N]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --devices) devices="${2:-}"; shift 2 ;;
      *) die "непонятный параметр: $1" ;;
    esac
  done
  valid_name "$name" || die "имя может содержать только латинские буквы, цифры, _ и - (3–36 символов), например ivan или masha_k"
  case "$devices" in "" ) ;; *[!0-9]*) die "--devices: нужно число" ;; esac
  api GET "/api/users/by-username/$name"
  [ "$HTTP_CODE" = "200" ] && die "пользователь $name уже есть; его ссылка: klaus-panel link $name"
  squad_uuid
  body="$(jq -nc --arg n "$name" --arg exp "$NEVER" --arg s "$SQUAD_UUID" --arg d "$devices" '{
      username: $n, expireAt: $exp, trafficLimitBytes: 0, trafficLimitStrategy: "NO_RESET",
      activeInternalSquads: [$s], description: "klaus-panel"
    } + (if $d != "" then {hwidDeviceLimit: ($d | tonumber)} else {} end)')"
  api_ok POST /api/users "$body"
  show_link "$RESP"
}

cmd_link() {
  [ -n "${1:-}" ] || die "укажите имя: klaus-panel link ИМЯ"
  user_json "$1"
  show_link "$RESP"
}

# Lists can be long (hundreds of users), so they go through files: jq
# arguments are limited to 128 KB.
TMPD=""
tmpdir() { [ -n "$TMPD" ] || { TMPD="$(mktemp -d)"; trap 'rm -rf "$TMPD"' EXIT; }; }

fetch_all() { # PATH KEY FILE: all pages of a list into FILE as one array
  local start=0 total
  tmpdir
  : > "$3.pages"
  while :; do
    api_ok GET "$1?start=$start&size=500"
    jq -c --arg k "$2" '.response[$k]' <<<"$RESP" >> "$3.pages"
    total="$(jq -r '.response.total' <<<"$RESP")"
    start=$((start + 500))
    [ "$start" -lt "$total" ] || break
  done
  jq -cs 'add // []' "$3.pages" > "$3"
}

cmd_list_users() {
  tmpdir
  fetch_all /api/users users "$TMPD/users.json"
  fetch_all /api/hwid/devices devices "$TMPD/devices.json"
  jq -r --slurpfile dev "$TMPD/devices.json" '
    def gb: . / 1073741824 * 100 | round / 100 | tostring + " ГБ";
    ($dev[0] | group_by(.userId) | map({key: (.[0].userId | tostring), value: length}) | from_entries) as $count
    | ["ИМЯ", "СТАТУС", "УСТРОЙСТВ", "ЛИМИТ", "ТРАФИК", "БЫЛ В СЕТИ"],
      (sort_by(.username)[] | [
        .username, .status, ($count[.id | tostring] // 0 | tostring),
        (.hwidDeviceLimit // "общий" | tostring),
        (.userTraffic.lifetimeUsedTrafficBytes | gb),
        (.userTraffic.onlineAt // "никогда" | sub("\\.[0-9]+Z$"; "") | sub("T"; " "))
      ])
    | @tsv' "$TMPD/users.json" | table
  echo
  echo "Всего: $(jq length "$TMPD/users.json")"
}

user_action() { # ACTION NAME
  [ -n "${2:-}" ] || die "укажите имя"
  local id
  user_json "$2"
  id="$(jq -r '.response.id' <<<"$RESP")"
  case "$1" in
    disable) api_ok POST "/api/users/$id/actions/disable"; say "$2 отключён: подписка и подключения больше не работают" ;;
    enable) api_ok POST "/api/users/$id/actions/enable"; say "$2 снова включён" ;;
    delete)
      confirm "Удалить $2 насовсем? Его ссылка перестанет работать."
      api_ok DELETE "/api/users/$id"
      say "$2 удалён"
      ;;
  esac
}

# ---------------------------------------------------------------- nodes
valid_address() { [[ "$1" =~ ^[A-Za-z0-9.:-]+$ ]]; }

cmd_add_node() {
  local name="" address="" country="XX" host="" title="" node_port=2222 body node_uuid secret
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="${2:-}"; shift 2 ;;
      --title) title="${2:-}"; shift 2 ;;
      --node-port) node_port="${2:-}"; shift 2 ;;
      -*) die "непонятный параметр: $1" ;;
      *)
        if [ -z "$name" ]; then name="$1"
        elif [ -z "$address" ]; then address="$1"
        else country="$1"; fi
        shift ;;
    esac
  done
  if [ -z "$name" ] || [ -z "$address" ]; then die "пример: klaus-panel add-node de-1 203.0.113.10 DE"; fi
  [[ "$name" =~ ^[A-Za-z0-9_.-]{3,30}$ ]] || die "имя сервера: 3–30 латинских букв, цифр, _ . -"
  host="${host:-$address}"
  title="${title:-$name}"
  [ "${#title}" -le 100 ] || die "--title: не длиннее 100 символов"
  # One exact address per server: the panel would pick a random entry from
  # a comma list (or random text for *) on every refresh, and the app would
  # reconnect each time.
  for a in "$address" "$host"; do
    valid_address "$a" || die "адрес «$a»: только IP или домен, без запятых, пробелов и *"
  done
  [[ "$country" =~ ^[A-Za-z]{2}$ ]] || die "страна — две латинские буквы, например DE или NL"
  country="$(printf '%s' "$country" | tr '[:lower:]' '[:upper:]')"
  [[ "$node_port" =~ ^[0-9]+$ ]] || die "--node-port: нужно число"
  api_ok GET /api/nodes
  jq -e --arg n "$name" 'any(.response[]; .name == $n)' <<<"$RESP" >/dev/null && die "сервер $name уже есть"
  profile_uuid

  body="$(jq -nc --arg n "$name" --arg a "$address" --argjson p "$node_port" --arg c "$country" \
    --arg pu "$PROFILE_UUID" --arg iu "$INBOUND_UUID" '{
      name: $n, address: $a, port: $p, countryCode: $c,
      configProfile: {activeConfigProfileUuid: $pu, activeInbounds: [$iu]}
    }')"
  api_ok POST /api/nodes "$body"
  node_uuid="$(jq -r '.response.uuid' <<<"$RESP")"
  # The host is what friends get in their subscription; "nodes" links it to
  # the server so disable-node can take it out.
  body="$(jq -nc --arg t "$title" --arg h "$host" --argjson port "$INBOUND_PORT" --arg pu "$PROFILE_UUID" \
    --arg iu "$INBOUND_UUID" --arg nu "$node_uuid" '{
      inbound: {configProfileUuid: $pu, configProfileInboundUuid: $iu},
      remark: $t, address: $h, port: $port, nodes: [$nu]
    }')"
  api_ok POST /api/hosts "$body"
  api_ok GET /api/keygen
  secret="$(jq -r '.response.secretKey' <<<"$RESP")"

  local extra=""
  [ "$node_port" != "2222" ] && extra+=" NODE_PORT=$node_port"
  [ "$INBOUND_PORT" != "443" ] && extra+=" VPN_PORT=$INBOUND_PORT"
  echo
  say "Сервер $name добавлен. Теперь на нём ($address) выполните (install-node.sh копируется так же, как install-panel.sh):"
  echo
  echo "sudo PANEL_IP=${PANEL_IP:-IP_ПАНЕЛИ}$extra SECRET_KEY='$secret' bash install-node.sh"
  echo
  echo "Через минуту после установки проверьте: klaus-panel list-nodes (должно быть «на связи»)."
  echo "Знакомые получат этот сервер сами при следующем обновлении подписки."
}

cmd_list_nodes() {
  local nodes
  tmpdir
  api_ok GET /api/nodes
  nodes="$RESP"
  api_ok GET /api/hosts
  printf '%s' "$RESP" > "$TMPD/hosts.json"
  jq -r --slurpfile hosts "$TMPD/hosts.json" '
    ["ИМЯ", "СТРАНА", "IP", "АДРЕС ДЛЯ ПРИЛОЖЕНИЙ", "СОСТОЯНИЕ", "ОНЛАЙН", "XRAY"],
    (.response[] | .uuid as $u | [
      .name, .countryCode, .address,
      ([$hosts[0].response[] | select(.nodes | index($u)) | "\(.address):\(.port)\(if .isDisabled then " (выкл.)" else "" end)"] | join(" ") | if . == "" then "-" else . end),
      (if .isDisabled then "отключён" elif .isConnected then "на связи" elif .isConnecting then "подключается" else "нет связи" end),
      (.usersOnline | tostring),
      (.versions.xray // "-")
    ]) | @tsv' <<<"$nodes" | table
}

node_action() { # enable|disable NAME
  [ -n "${2:-}" ] || die "укажите имя сервера"
  local uuid host_uuids
  node_json "$2"
  uuid="$(jq -r '.uuid' <<<"$NODE")"
  api_ok GET /api/hosts
  host_uuids="$(jq -c --arg u "$uuid" '[.response[] | select(.nodes | index($u)) | .uuid]' <<<"$RESP")"
  # The panel hands out hosts regardless of their server's state, so the
  # host has to be switched together with the server.
  api_ok POST "/api/nodes/$uuid/actions/$1"
  if [ "$(jq length <<<"$host_uuids")" -gt 0 ]; then
    api_ok POST "/api/hosts/bulk/$1" "$(jq -nc --argjson h "$host_uuids" '{uuids: $h}')"
  fi
  if [ "$1" = "disable" ]; then
    say "$2 убран из подписок; приложения знакомых переключатся на другие серверы при обновлении подписки"
  else
    say "$2 снова в подписках"
  fi
}

# ---------------------------------------------------------------- misc
cmd_hwid_limit() {
  local n="${1:-}" body missing
  case "$n" in
    off)
      api_ok GET /api/subscription-settings
      body="$(jq -c '.response | {uuid, hwidSettings: (.hwidSettings | .enabled = false)}' <<<"$RESP")"
      api_ok PATCH /api/subscription-settings "$body"
      say "Лимит устройств выключен (устройства по-прежнему записываются)"
      return ;;
    "" | *[!0-9]*) die "пример: klaus-panel hwid-limit 3   (или off)" ;;
  esac
  [ "$n" -ge 1 ] || die "лимит должен быть не меньше 1"
  # Friends whose app has never sent a device id would be cut off.
  tmpdir
  fetch_all /api/users users "$TMPD/users.json"
  fetch_all /api/hwid/devices devices "$TMPD/devices.json"
  missing="$(jq -r --slurpfile dev "$TMPD/devices.json" '($dev[0] | map(.userId)) as $ids
    | [.[] | select(.status == "ACTIVE") | select(.id as $i | $ids | index($i) | not) | .username] | join(", ")' "$TMPD/users.json")"
  echo "Лимит устройств на человека: $n (кроме тех, кому задан свой через --devices)."
  echo "Включайте, только когда у всех стоит версия Klaus VPN, которая сообщает панели"
  echo "устройство, и сборки подписаны постоянным ключом (раздел «Подпись приложения»)."
  if [ -n "$missing" ]; then
    warn "у этих подписок ещё нет ни одного устройства — они сразу перестанут получать серверы: $missing"
  fi
  confirm "Включить лимит?"
  api_ok GET /api/subscription-settings
  body="$(jq -c --argjson n "$n" '.response | {uuid, hwidSettings: (.hwidSettings | .enabled = true | .fallbackDeviceLimit = $n)}' <<<"$RESP")"
  api_ok PATCH /api/subscription-settings "$body"
  say "Лимит устройств включён. Освободить место: панель → пользователь → устройства → удалить старое"
}

cmd_backup() {
  local tmp out stamp pg_user pg_db
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  tmpdir
  tmp="$TMPD"
  pg_user="$(sed -n 's/^POSTGRES_USER=//p' "$RW_DIR/.env")"
  pg_db="$(sed -n 's/^POSTGRES_DB=//p' "$RW_DIR/.env")"
  say "Копирую базу (пользователи, серверы, ключи)"
  docker exec remnawave-db pg_dump -U "${pg_user:-postgres}" -d "${pg_db:-postgres}" -Fc > "$tmp/remnawave-db.dump" ||
    die "pg_dump не сработал (запущен ли контейнер remnawave-db?)"
  # .env holds APP_SECRET: without it the restored panel would not accept
  # the servers' and tokens' signatures.
  for f in .env subscription.env klaus-panel.env klaus-monitor.env docker-compose.yml Caddyfile; do
    if [ -f "$RW_DIR/$f" ]; then cp -p "$RW_DIR/$f" "$tmp/"; fi
  done
  # The published app: version.json and the APK it names (KlausVPN.apk is
  # the same file, one more name for it: cp -a keeps them one file).
  if [ -f "$APP_DIR/version.json" ]; then
    local apk files=("$APP_DIR/version.json")
    apk="$(jq -r '.apk // "" | split("/") | last' "$APP_DIR/version.json")"
    if [[ "$apk" =~ ^KlausVPN-[0-9A-Za-z._-]+\.apk$ ]] && [ -f "$APP_DIR/$apk" ]; then files+=("$APP_DIR/$apk"); fi
    if [ -f "$APP_DIR/KlausVPN.apk" ]; then files+=("$APP_DIR/KlausVPN.apk"); fi
    mkdir -p "$tmp/app"
    cp -a "${files[@]}" "$tmp/app/"
  fi
  if [ -n "${ADMIN_FILE:-}" ] && [ -f "$ADMIN_FILE" ]; then cp -p "$ADMIN_FILE" "$tmp/admin.txt"; fi
  if grep -qx caddy <<<"$(docker ps --format '{{.Names}}')"; then
    docker exec caddy tar -C /data -cf - . > "$tmp/caddy-data.tar" || warn "не удалось скопировать сертификаты Caddy (не страшно: получит новые)"
  fi
  out="$BACKUP_DIR/klausvpn-panel-$stamp.tar.gz"
  (umask 077 && tar -C "$tmp" -czf "$out" .)
  say "Готово: $out ($(du -h "$out" | cut -f1))"
  echo "Скачайте файл к себе (scp root@сервер:$out .) и храните в надёжном месте: в нём все ключи."
}

# ---------------------------------------------------------------- telegram
# Telegram Bot API; the token is part of the URL, so the URL goes to curl
# through a file (never in "ps").
tg() { # METHOD [JSON]; uses TG_TOKEN, sets TG_RESP and TG_CODE
  local tmp
  tmp="$(mktemp -d)"
  printf 'url = "%s/bot%s/%s"\n' "$TELEGRAM_API_BASE" "$TG_TOKEN" "$1" > "$tmp/c"
  printf '%s' "${2:-"{}"}" > "$tmp/b"
  TG_CODE="$(curl -sS --max-time 40 -K "$tmp/c" -o "$tmp/o" -w '%{http_code}' \
    -H 'Content-Type: application/json' --data-binary "@$tmp/b" 2>/dev/null)" || TG_CODE=000
  TG_RESP="$(cat "$tmp/o" 2>/dev/null || true)"
  rm -rf "$tmp"
}

tg_send() { # TEXT: to the saved chat ("chat" or "chat:topic", as the panel takes it), or dies
  tg sendMessage "$(jq -nc --arg c "$TELEGRAM_CHAT_ID" --arg t "$1" '($c | split(":")) as $ct
    | {chat_id: $ct[0], text: $t, link_preview_options: {is_disabled: true}}
    + (if ($ct | length) > 1 then {message_thread_id: ($ct[1] | tonumber)} else {} end)')"
  { [ "$TG_CODE" = "200" ] && [ "$(jq -r '.ok' <<<"$TG_RESP" 2>/dev/null)" = "true" ]; } ||
    die "Telegram не принял сообщение (ответ $TG_CODE${TG_RESP:+: $(jq -r '.description // empty' <<<"$TG_RESP" 2>/dev/null)})"
}

# The panel of an older install-panel.sh has no monitor and no Telegram
# lines to fill in.
need_new_panel() {
  { grep -q '^TELEGRAM_BOT_API_ROOT=' "$RW_DIR/.env" 2>/dev/null && grep -q 'klaus-monitor:' "$RW_DIR/docker-compose.yml" 2>/dev/null; } ||
    die "панель установлена старой версией install-panel.sh: запустите новую версию ещё раз (sudo bash install-panel.sh), затем повторите"
}

cmd_telegram_setup() {
  local token="${1:-}" bot code chat="" who="" offset=0 deadline upd
  if [ -z "$token" ]; then
    [ -t 0 ] || die "укажите токен бота: klaus-panel telegram-setup ТОКЕН"
    read -r -s -p "Токен бота (его выдаёт @BotFather): " token
    echo
  fi
  [[ "$token" =~ ^[0-9]{5,}:[A-Za-z0-9_-]{30,}$ ]] || die "это не токен бота (он выглядит так: 123456789:AAE…); его выдаёт @BotFather"
  [[ "$TELEGRAM_API_BASE" =~ ^https?://[A-Za-z0-9.:_-]+(/[A-Za-z0-9._/-]*)?$ ]] || die "странный адрес $TELEGRAM_API_BASE"
  need_new_panel
  TG_TOKEN="$token"
  tg getMe
  case "$TG_CODE" in
    200) ;;
    401 | 404) die "Telegram не принял токен: скопируйте его ещё раз (@BotFather → /mybots → бот → API Token)" ;;
    000) die "нет связи с $TELEGRAM_API_BASE" ;;
    *) die "Telegram ответил $TG_CODE" ;;
  esac
  bot="$(jq -r '.result.username // empty' <<<"$TG_RESP")"
  # Messages the bot got before (the owner's old ones, or anybody's: bots
  # can be found by name) do not count: the queue is emptied first, and
  # only a message with this one-time code is taken.
  code="$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$code" =~ ^[0-9a-f]{12}$ ]] || die "не удалось получить случайный код"
  tg getUpdates '{"offset": -1, "timeout": 0}'
  case "$TG_CODE" in
    200) offset="$(jq -r '[.result[]?.update_id] | max | if . == null then 0 else . + 1 end' <<<"$TG_RESP" 2>/dev/null || echo 0)" ;;
    409) die "этот бот уже подключён к другой программе (вебхук): создайте для оповещений отдельного бота" ;;
  esac
  [[ "$offset" =~ ^[0-9]+$ ]] || offset=0
  say "Бот @$bot. Откройте ссылку https://t.me/$bot?start=$code и нажмите «Запустить» (или отправьте боту код $code)."
  echo "Чтобы оповещения приходили в группу, откройте https://t.me/$bot?startgroup=$code и выберите группу. Жду до 10 минут…"
  deadline=$((SECONDS + 600))
  while [ -z "$chat" ]; do
    [ "$SECONDS" -lt "$deadline" ] || die "сообщение с кодом так и не пришло; запустите команду ещё раз"
    tg getUpdates "$(jq -nc --argjson o "$offset" '{offset: $o, timeout: 20, allowed_updates: ["message"]}')"
    case "$TG_CODE" in
      200) ;;
      409) die "этот бот уже подключён к другой программе (вебхук): создайте для оповещений отдельного бота" ;;
      *) sleep 3; continue ;;
    esac
    offset="$(jq -r --argjson o "$offset" '[.result[].update_id] | max | if . == null then $o else . + 1 end' <<<"$TG_RESP")"
    upd="$(jq -c --arg c "$code" '[.result[] | select(.message.chat.id != null and ((.message.text // "") | contains($c)))] | last // empty' <<<"$TG_RESP")"
    if [ -n "$upd" ]; then
      chat="$(jq -r '.message.chat.id' <<<"$upd")"
      who="$(jq -r '.message.chat | .title // ([.first_name, .last_name, (if .username then "@" + .username else null end)] | map(select(. != null)) | join(" "))' <<<"$upd")"
    elif [ "$(jq '[.result[] | select(.message.chat.id != null)] | length' <<<"$TG_RESP")" != "0" ]; then
      echo "Пришло сообщение без кода — пропускаю. Откройте ссылку выше или отправьте боту код $code"
    fi
  done
  [[ "$chat" =~ ^-?[0-9]{1,20}$ ]] || die "странный номер чата: $chat"
  # Mark the messages as read, so the next setup does not pick them up.
  tg getUpdates "$(jq -nc --argjson o "$offset" '{offset: $o, timeout: 0}')"
  say "Сообщение пришло из чата «$who» ($chat): оповещения будут приходить туда"

  TELEGRAM_BOT_TOKEN="$token"
  TELEGRAM_CHAT_ID="$chat"
  set_line "$CONF" TELEGRAM_BOT_TOKEN "$(printf '%q' "$token")"
  set_line "$CONF" TELEGRAM_CHAT_ID "$(printf '%q' "$chat")"
  set_line "$CONF" TELEGRAM_API_BASE "$(printf '%q' "$TELEGRAM_API_BASE")"
  # The panel's own messages (servers lost and back): the same lines as
  # install-panel.sh writes.
  set_line "$RW_DIR/.env" IS_TELEGRAM_NOTIFICATIONS_ENABLED true
  set_line "$RW_DIR/.env" TELEGRAM_BOT_TOKEN "$token"
  set_line "$RW_DIR/.env" TELEGRAM_BOT_API_ROOT "$TELEGRAM_API_BASE"
  set_line "$RW_DIR/.env" TELEGRAM_NOTIFY_NODES "$chat"
  write_monitor_env
  say "Перезапускаю панель и монитор блокировок с новыми настройками"
  # Exactly what install-panel.sh would start: every container whose
  # settings changed is recreated.
  compose up -d || die "контейнеры не перезапустились (подробности выше)"
  local i
  for i in $(seq 1 60); do
    api GET /api/auth/status
    [ "$HTTP_CODE" = "200" ] && break
    [ "$i" -eq 60 ] && die "панель не запустилась после перезапуска: docker logs remnawave"
    sleep 3
  done
  tg_send "Klaus VPN: оповещения включены.
Сюда придёт сообщение, если VPN-сервер потеряет связь с панелью или если у знакомых он перестанет открываться (похоже на блокировку)."
  say "Готово: проверочное сообщение отправлено в Telegram"
}

cmd_telegram_test() {
  { [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; } ||
    die "оповещения ещё не настроены: klaus-panel telegram-setup ТОКЕН"
  TG_TOKEN="$TELEGRAM_BOT_TOKEN"
  tg_send "Klaus VPN: проверка оповещений. Всё работает."
  say "Проверочное сообщение отправлено"
}

# ---------------------------------------------------------------- app
# New builds of the app from the GitHub releases (private repository: a
# read-only token) go to https://SUB_DOMAIN/app/: KlausVPN.apk,
# KlausVPN-<version>.apk and version.json, which the app checks for updates.
# Only from RELEASE_TAG, "stable" by default: CI makes it on purpose, never
# on every push like the build-<branch> test builds.
gh_get() { # URL FILE [ACCEPT] [SECONDS]; sets GH_CODE. The token goes to curl
  # through a file; curl does not pass it on when GitHub redirects a
  # download to its file storage.
  local tmp
  tmp="$(mktemp -d)"
  printf 'Authorization: Bearer %s\nAccept: %s\nX-GitHub-Api-Version: 2022-11-28\n' \
    "$GITHUB_TOKEN" "${3:-application/vnd.github+json}" > "$tmp/h"
  GH_CODE="$(curl -sS -L --max-time "${4:-60}" --max-filesize 314572800 -A klaus-panel \
    -H "@$tmp/h" -o "$2" -w '%{http_code}' "$1" 2>/dev/null)" || GH_CODE=000
  rm -rf "$tmp"
}

page_button() { # the page's download button; if the panel cannot take it
  # now, only a warning: the build is out, the next run tries again.
  local rc
  set +e
  (
    set -e
    setup_subpage
  )
  rc=$?
  set -e
  [ "$rc" = "0" ] || warn "кнопку «Скачать приложение» на странице подписки поставить не удалось, попробую при следующей проверке"
}

cmd_publish_apk() {
  local tag="${RELEASE_TAG:-stable}" repo="${GITHUB_REPO:-klausms17/vpn}"
  local gh="${GITHUB_API:-https://api.github.com}" quiet=0
  local apk apk_url sums_url ver code sha cur_code=0 cur_sha="" cur_apk="" got staging
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag) tag="${2:-}"; shift 2 ;;
      --quiet) quiet=1; shift ;;
      *) die "непонятный параметр: $1" ;;
    esac
  done
  if [ -z "${GITHUB_TOKEN:-}" ]; then
    # The hourly timer: nothing to do until a token is given.
    [ "$quiet" = "1" ] && return 0
    die "нет GITHUB_TOKEN: создайте токен только для чтения (инструкция, раздел 12) и запустите sudo GITHUB_TOKEN=… bash install-panel.sh"
  fi
  [[ "$tag" =~ ^[A-Za-z0-9._/-]+$ ]] || die "странное имя релиза: $tag"
  note() { if [ "$quiet" != "1" ]; then say "$@"; fi; }
  mkdir -p "$APP_DIR"
  # One at a time (the timer and a manual run).
  exec 9>"$RW_DIR/.publish-apk.lock"
  if command -v flock >/dev/null; then flock -n 9 || die "публикация уже идёт"; fi
  tmpdir

  gh_get "$gh/repos/$repo/releases/tags/$tag" "$TMPD/release.json"
  case "$GH_CODE" in
    200) ;;
    401) die "GitHub не принял GITHUB_TOKEN (истёк или отозван?)" ;;
    404)
      # GitHub says the same about a repository the token cannot see; the
      # repository itself tells the two apart.
      gh_get "$gh/repos/$repo" "$TMPD/repo.json"
      [ "$GH_CODE" = "200" ] ||
        die "релиз $tag в $repo не найден или у токена нет доступа (нужно: Contents — Read-only для $repo)"
      # No stable build made yet, or CI is replacing it right now: the
      # timer looks again in an hour.
      [ "$quiet" = "1" ] && return 0
      if [ "$tag" = "stable" ]; then
        die "в $repo ещё нет релиза stable: стабильную сборку выпускает GitHub Actions по тегу v… или по кнопке Run workflow с галочкой stable (инструкция, раздел 12)"
      fi
      die "в $repo нет релиза $tag" ;;
    403) die "релиз $tag в $repo не найден или у токена нет доступа (нужно: Contents — Read-only для $repo)" ;;
    000) die "нет связи с $gh" ;;
    *) die "GitHub ответил $GH_CODE" ;;
  esac
  # CI marks builds signed with a throwaway key (no signing key in its
  # secrets): every one has another signature, so Android refuses to put
  # it over the installed app. Friends are not offered such builds.
  if jq -e '(.name // "") | contains("временная подпись")' "$TMPD/release.json" >/dev/null &&
    [ "${ALLOW_TEMP_KEY:-0}" != "1" ]; then
    [ "$quiet" = "1" ] && return 0
    die "сборка в релизе $tag подписана временным ключом: приложения знакомых не смогут на неё обновиться. Добавьте постоянный ключ подписи (инструкция, раздел 9) и дождитесь новой сборки. Выложить всё равно: ALLOW_TEMP_KEY=1 klaus-panel publish-apk"
  fi
  apk="$(jq -r 'first(.assets[]? | select(.name | test("^KlausVPN-[0-9A-Za-z._-]+\\.apk$")) | .name) // empty' "$TMPD/release.json")"
  apk_url="$(jq -r --arg n "$apk" 'first(.assets[]? | select(.name == $n) | .url) // empty' "$TMPD/release.json")"
  sums_url="$(jq -r 'first(.assets[]? | select(.name == "SHA256SUMS.txt") | .url) // empty' "$TMPD/release.json")"
  { [ -n "$apk" ] && [ -n "$apk_url" ]; } || die "в релизе $tag нет файла KlausVPN-….apk"
  [ -n "$sums_url" ] || die "в релизе $tag нет SHA256SUMS.txt: без контрольной суммы файл не публикуется"
  ver="${apk#KlausVPN-}"
  ver="${ver%.apk}"
  # CI names builds 1.0.<run number>: the last number is the versionCode.
  [[ "$ver" =~ ([0-9]+)$ ]] || die "из имени $apk не понять номер версии"
  code=$((10#${BASH_REMATCH[1]}))

  gh_get "$sums_url" "$TMPD/sums" application/octet-stream
  [ "$GH_CODE" = "200" ] || die "не удалось скачать SHA256SUMS.txt (ответ $GH_CODE)"
  sha="$(awk -v f="$apk" '($2 == f || $2 == "*" f) && $1 ~ /^[0-9A-Fa-f]+$/ && length($1) == 64 { print tolower($1); exit }' "$TMPD/sums")"
  [ -n "$sha" ] || die "в SHA256SUMS.txt нет контрольной суммы $apk"

  if [ -f "$APP_DIR/version.json" ]; then
    cur_code="$(jq -r '.versionCode // 0' "$APP_DIR/version.json")"
    cur_sha="$(jq -r '.sha256 // ""' "$APP_DIR/version.json")"
    cur_apk="$(jq -r '.apk // "" | split("/") | last' "$APP_DIR/version.json")"
    [[ "$cur_code" =~ ^[0-9]+$ ]] || cur_code=0
  fi
  if [ "$cur_sha" = "$sha" ] && [ -f "$APP_DIR/$apk" ] && [ -f "$APP_DIR/KlausVPN.apk" ]; then
    # A run that could not reach the panel left the page without its button.
    page_button
    note "Версия $ver уже опубликована: https://$SUB_DOMAIN/app/KlausVPN.apk"
    return 0
  fi
  if [ "$cur_code" -gt "$code" ]; then
    note "На сервере уже версия новее ($cur_apk), чем $apk в релизе $tag: оставляю её"
    return 0
  fi

  note "Скачиваю $apk из релиза $tag"
  staging="$RW_DIR/.app-staging"
  rm -rf "$staging"
  mkdir -p "$staging"
  gh_get "$apk_url" "$staging/$apk" application/octet-stream 900
  if [ "$GH_CODE" != "200" ]; then rm -rf "$staging"; die "не удалось скачать $apk (ответ $GH_CODE)"; fi
  got="$(sha256sum "$staging/$apk" | cut -d' ' -f1)"
  if [ "$got" != "$sha" ]; then
    rm -rf "$staging"
    die "контрольная сумма $apk не совпала с SHA256SUMS.txt: файл повреждён или подменён. Ничего не опубликовано"
  fi
  # The versioned file first, then the fixed name, then version.json: it
  # never names a file that is not there yet.
  chmod 644 "$staging/$apk"
  mv -f "$staging/$apk" "$APP_DIR/$apk"
  ln -f "$APP_DIR/$apk" "$staging/KlausVPN.apk"
  mv -f "$staging/KlausVPN.apk" "$APP_DIR/KlausVPN.apk"
  jq -n --argjson c "$code" --arg n "$ver" --arg a "https://$SUB_DOMAIN/app/$apk" --arg s "$sha" \
    '{versionCode: $c, versionName: $n, apk: $a, sha256: $s}' > "$staging/version.json"
  chmod 644 "$staging/version.json"
  mv -f "$staging/version.json" "$APP_DIR/version.json"
  rm -rf "$staging"
  # An app shows the update it found for up to 12 hours before it checks
  # again, so a replaced build stays 13 hours (its file's time says when
  # it was replaced), then goes.
  if [[ "$cur_apk" =~ ^KlausVPN-[0-9A-Za-z._-]+\.apk$ ]] && [ "$cur_apk" != "$apk" ] && [ -f "$APP_DIR/$cur_apk" ]; then
    touch "$APP_DIR/$cur_apk"
  fi
  find "$APP_DIR" -maxdepth 1 -type f -name 'KlausVPN-*.apk' ! -name "$apk" -mmin +780 -delete
  page_button
  note "Опубликована версия $ver: https://$SUB_DOMAIN/app/KlausVPN.apk (приложения знакомых предложат обновиться)"
}

# ---------------------------------------------------------------- main
cmd="${1:-help}"
[ $# -gt 0 ] && shift
YES=0
args=()
for a in "$@"; do
  if [ "$a" = "--yes" ] || [ "$a" = "-y" ]; then YES=1; else args+=("$a"); fi
done
set -- "${args[@]}"

case "$cmd" in
  help | -h | --help) usage; exit 0 ;;
esac
load_conf
case "$cmd" in
  setup) cmd_setup ;;
  add-user) cmd_add_user "$@" ;;
  link) cmd_link "$@" ;;
  list-users) cmd_list_users ;;
  disable-user) user_action disable "$@" ;;
  enable-user) user_action enable "$@" ;;
  delete-user) user_action delete "$@" ;;
  add-node) cmd_add_node "$@" ;;
  list-nodes) cmd_list_nodes ;;
  disable-node) node_action disable "$@" ;;
  enable-node) node_action enable "$@" ;;
  hwid-limit) cmd_hwid_limit "$@" ;;
  backup) cmd_backup ;;
  telegram-setup) cmd_telegram_setup "$@" ;;
  telegram-test) cmd_telegram_test ;;
  publish-apk) cmd_publish_apk "$@" ;;
  *) usage >&2; exit 1 ;;
esac
