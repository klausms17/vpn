#!/usr/bin/env bash
# klaus-panel: friends and VPN servers of the Klaus VPN Remnawave panel.
#
# Installed to /usr/local/bin by install-panel.sh. Talks to the panel API on
# 127.0.0.1:3000 with the token from /opt/remnawave/klaus-panel.env (the
# KLAUS_PANEL_CONF variable points elsewhere). Run "klaus-panel help".
set -euo pipefail
umask 077

CONF="${KLAUS_PANEL_CONF:-/opt/remnawave/klaus-panel.env}"
PROFILE_NAME="KlausVPN"   # config profile shared by all VPN servers
SQUAD_NAME="KlausVPN"     # internal squad every friend is in
INBOUND_TAG="VLESS_REALITY"
RULE_NAME="Klaus VPN"
APP_NAME="Klaus VPN"
NEVER="2099-12-31T00:00:00.000Z" # the panel needs an expiry date
BACKUP_DIR="${BACKUP_DIR:-/root/remnawave-backups}"
# A Telegram API address given on the command line wins over the saved one
# (the local test's mock); telegram-setup saves it.
TELEGRAM_API_BASE_ENV="${TELEGRAM_API_BASE:-}"

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mВнимание:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mОшибка:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
klaus-panel — управление панелью Klaus VPN

Знакомые:
  add-user ИМЯ [--devices N]   новая подписка: ссылка, QR-код и ссылка для приложения
                               (--devices — сколько устройств разрешить, когда включён лимит)
  link ИМЯ                     снова показать ссылку и QR-код
  list-users                   все подписки: статус, устройства, трафик
  disable-user ИМЯ             временно отключить (ссылка перестанет работать)
  enable-user ИМЯ              включить обратно
  delete-user ИМЯ [--yes]      удалить совсем

VPN-серверы:
  add-node ИМЯ IP [СТРАНА] [--title НАЗВАНИЕ] [--host АДРЕС] [--node-port 2222]
                               добавить сервер и показать команду для его установки
                               (СТРАНА — код из двух букв, например DE; --title — как
                               сервер называется в приложении, по умолчанию ИМЯ; --host —
                               адрес для приложений, если он не совпадает с IP, например домен)
  list-nodes                   серверы и их состояние
  disable-node ИМЯ             убрать сервер из подписок (например, заблокирован)
  enable-node ИМЯ              вернуть сервер

Оповещения и приложение:
  telegram-setup [ТОКЕН]       оповещения в Telegram: токен бота от @BotFather, затем
                               откройте показанную ссылку и нажмите «Запустить»
  telegram-test                отправить проверочное сообщение
  publish-apk [--tag РЕЛИЗ]    выложить новую стабильную сборку приложения (релиз stable)
                               на адрес подписки (нужен GITHUB_TOKEN; раз в час это
                               делается само)

Прочее:
  hwid-limit N [--yes]         включить лимит устройств (N на человека); off — выключить
  backup                       резервная копия базы и настроек в /root/remnawave-backups
EOF
}

load_conf() {
  [ -r "$CONF" ] || die "не найден $CONF: запустите от root (sudo) после install-panel.sh"
  # shellcheck disable=SC1090
  . "$CONF"
  : "${API_URL:?}" "${API_TOKEN:?}" "${RW_DIR:?}"
  command -v jq >/dev/null || die "нужна программа jq (apt install jq)"
  TELEGRAM_API_BASE="${TELEGRAM_API_BASE_ENV:-${TELEGRAM_API_BASE:-https://api.telegram.org}}"
  APP_DIR="$RW_DIR/app"
}

# ---------------------------------------------------------------- files
# Replace a file only when its content changes (stdin -> FILE).
write_file() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  cat > "$tmp"
  if [ -f "$1" ] && cmp -s "$1" "$tmp"; then rm -f "$tmp"; return 0; fi
  if [ -f "$1" ]; then chmod --reference="$1" "$tmp"; fi
  mv "$tmp" "$1"
}
# KEY=VALUE in place of the file's KEY line (added at the end when missing).
# install-panel.sh writes the same lines, so its next run changes nothing.
set_line() { # FILE KEY VALUE; the value (a token) goes to awk through the
  # environment: arguments show in "ps", and -v would change backslashes.
  K="$2" V="$3" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print } END { if (!done) print k "=" v }' "$1" | write_file "$1"
}

# The monitor's settings, from klaus-panel.env (install-panel.sh and
# telegram-setup call this).
write_monitor_env() {
  write_file "$RW_DIR/klaus-monitor.env" <<EOF
# Written by klaus-panel from klaus-panel.env; rewritten on every change.
PANEL_URL=http://remnawave:3000
PANEL_TOKEN=${MONITOR_TOKEN:-}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID:-}
TELEGRAM_API_BASE=$TELEGRAM_API_BASE
REPORT_THRESHOLD=${REPORT_THRESHOLD:-2}
REPORT_WINDOW_MIN=${REPORT_WINDOW_MIN:-20}
REPORT_COOLDOWN_MIN=${REPORT_COOLDOWN_MIN:-180}
EOF
}

# docker compose in the panel's folder, quiet unless it fails.
compose() {
  local log
  log="$(mktemp)"
  if ! (cd "$RW_DIR" && docker compose "$@") >"$log" 2>&1; then
    tail -n 30 "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
}

# ---------------------------------------------------------------- API
# Every call must look like it came through the HTTPS reverse proxy (the
# panel drops anything else). The token and body go through files, so they
# never show up in "ps".
api() { # METHOD PATH [BODY]; sets RESP and HTTP_CODE
  local tmp data=()
  tmp="$(mktemp -d)"
  printf 'X-Forwarded-For: 127.0.0.1\nX-Forwarded-Proto: https\nContent-Type: application/json\nAuthorization: Bearer %s\n' \
    "$API_TOKEN" > "$tmp/h"
  if [ -n "${3:-}" ]; then printf '%s' "$3" > "$tmp/b"; data=(--data-binary "@$tmp/b"); fi
  HTTP_CODE="$(curl -sS --noproxy '*' --max-time 60 -o "$tmp/o" -w '%{http_code}' -X "$1" \
    -H "@$tmp/h" "${data[@]}" "$API_URL$2" 2>/dev/null)" || HTTP_CODE=000
  RESP="$(cat "$tmp/o" 2>/dev/null || true)"
  rm -rf "$tmp"
}
api_ok() { # like api, but stops on an error
  api "$@"
  check_resp "$1" "$2"
}
check_resp() { # METHOD PATH: stops if the last answer was an error
  case "$HTTP_CODE" in
    2??) return 0 ;;
    000) die "панель не отвечает на $API_URL (docker ps: запущен ли контейнер remnawave?)" ;;
  esac
  local msg
  msg="$(jq -r '[.message // empty, (.errors // empty | tostring)] | join(": ")' <<<"$RESP" 2>/dev/null || true)"
  die "панель ответила $HTTP_CODE на $1 $2${msg:+: ${msg:0:400}}"
}

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{3,36}$ ]]; }

user_json() { # NAME -> RESP (user object) or dies
  valid_name "$1" || die "имя может содержать только латинские буквы, цифры, _ и - (3–36 символов)"
  api GET "/api/users/by-username/$1"
  [ "$HTTP_CODE" != "404" ] || die "нет пользователя $1 (список: klaus-panel list-users)"
  check_resp GET "/api/users/by-username/$1"
}

profile_uuid() {
  api_ok GET /api/config-profiles
  PROFILE_UUID="$(jq -r --arg n "$PROFILE_NAME" 'first(.response.configProfiles[] | select(.name == $n) | .uuid) // empty' <<<"$RESP")"
  [ -n "$PROFILE_UUID" ] || die "в панели нет профиля $PROFILE_NAME: запустите install-panel.sh ещё раз"
  api_ok GET "/api/config-profiles/$PROFILE_UUID/inbounds"
  INBOUND_UUID="$(jq -r --arg t "$INBOUND_TAG" 'first(.response.inbounds[] | select(.tag == $t) | .uuid) // empty' <<<"$RESP")"
  INBOUND_PORT="$(jq -r --arg t "$INBOUND_TAG" 'first(.response.inbounds[] | select(.tag == $t) | .port) // empty' <<<"$RESP")"
  [ -n "$INBOUND_UUID" ] || die "в профиле $PROFILE_NAME нет входа $INBOUND_TAG: запустите install-panel.sh ещё раз"
}

squad_uuid() {
  api_ok GET /api/internal-squads
  SQUAD_UUID="$(jq -r --arg n "$SQUAD_NAME" 'first(.response.internalSquads[] | select(.name == $n) | .uuid) // empty' <<<"$RESP")"
  [ -n "$SQUAD_UUID" ] || die "в панели нет группы $SQUAD_NAME: запустите install-panel.sh ещё раз"
}

node_json() { # NAME -> NODE (node object) or dies
  api_ok GET /api/nodes
  NODE="$(jq -c --arg n "$1" 'first(.response[] | select(.name == $n)) // empty' <<<"$RESP")"
  [ -n "$NODE" ] || die "нет сервера $1 (список: klaus-panel list-nodes)"
}

table() { if command -v column >/dev/null; then column -t -s "$(printf '\t')"; else cat; fi; }

confirm() { # QUESTION; --yes on the command line skips it
  [ "${YES:-0}" = "1" ] && return 0
  [ -t 0 ] || die "нужно подтверждение: добавьте --yes"
  local a
  read -r -p "$1 [y/N] " a
  case "$a" in y | Y | yes | д | Д | да) return 0 ;; esac
  die "отменено"
}

# ---------------------------------------------------------------- setup
# Called by install-panel.sh; safe to run again (e.g. after changing
# APK_URL): keeps keys and anything added in the panel by hand. The support
# link is the exception: it always follows SUPPORT_URL, also when that is
# removed.

profile_config() { # CURRENT_CONFIG_JSON PRIVATE_KEY SHORT_ID
  local target="${REALITY_TARGET:-$REALITY_SNI:443}"
  jq -c --arg tag "$INBOUND_TAG" --argjson port "$REALITY_PORT" --arg sni "$REALITY_SNI" \
    --arg target "$target" --arg key "$2" --arg sid "$3" '
    def ours: {
      tag: $tag, listen: "0.0.0.0", port: $port, protocol: "vless",
      settings: {clients: [], decryption: "none"},
      sniffing: {enabled: true, destOverride: ["http", "tls", "quic"], routeOnly: true},
      streamSettings: {network: "raw", security: "reality",
        realitySettings: {target: $target, serverNames: [$sni], privateKey: $key, shortIds: [$sid]}}
    };
    (if . == null then {
      log: {loglevel: "warning"},
      inbounds: [ours],
      outbounds: [{tag: "DIRECT", protocol: "freedom"}, {tag: "BLOCK", protocol: "blackhole"}],
      routing: {rules: [
        # Friends must not reach local services of the server; torrents
        # bring abuse complaints to the hoster.
        {ip: ["geoip:private"], outboundTag: "BLOCK"},
        {protocol: ["bittorrent"], outboundTag: "BLOCK"}
      ]}
    } else
      (.inbounds[] | select(.tag == $tag)) |= (.port = $port
        | .streamSettings.realitySettings.target = $target
        | .streamSettings.realitySettings.serverNames = [$sni])
    end)
    # Xray closes a connection after 5 idle minutes by default, and phones
    # keep push channels (Google push, mail) quiet for 15-28 minutes: each
    # would be cut and redone every 5 minutes, waking the phone. 30 minutes
    # outlasts them. The node keeps level 0 settings next to its own
    # statistics switches. A value set by hand in the panel stays.
    | .policy.levels["0"].connIdle //= 1800' <<<"$1"
}

setup_profile() {
  local cur new key sid
  api_ok GET /api/config-profiles
  PROFILE_UUID="$(jq -r --arg n "$PROFILE_NAME" 'first(.response.configProfiles[] | select(.name == $n) | .uuid) // empty' <<<"$RESP")"
  if [ -z "$PROFILE_UUID" ]; then
    say "Создаю профиль $PROFILE_NAME (VLESS + REALITY, порт $REALITY_PORT, маскировка под $REALITY_SNI)"
    api_ok GET /api/system/tools/x25519/generate
    key="$(jq -r '.response.keypairs[0].privateKey' <<<"$RESP")"
    sid="$(openssl rand -hex 8)"
    new="$(profile_config null "$key" "$sid")"
    api_ok POST /api/config-profiles "$(jq -nc --arg n "$PROFILE_NAME" --argjson c "$new" '{name: $n, config: $c}')"
    PROFILE_UUID="$(jq -r '.response.uuid' <<<"$RESP")"
  else
    api_ok GET "/api/config-profiles/$PROFILE_UUID"
    cur="$(jq -c '.response.config' <<<"$RESP")"
    jq -e --arg t "$INBOUND_TAG" '.inbounds[]? | select(.tag == $t)' <<<"$cur" >/dev/null ||
      die "в профиле $PROFILE_NAME нет входа $INBOUND_TAG (его удалили в панели?)"
    new="$(profile_config "$cur" "" "")"
    if ! jq -en --argjson a "$cur" --argjson b "$new" '$a == $b' >/dev/null; then
      say "Обновляю профиль $PROFILE_NAME (порт $REALITY_PORT, маскировка под $REALITY_SNI)"
      api_ok PATCH /api/config-profiles "$(jq -nc --arg u "$PROFILE_UUID" --argjson c "$new" '{uuid: $u, config: $c}')"
    fi
  fi
  profile_uuid
}

setup_squad() {
  api_ok GET /api/internal-squads
  SQUAD_UUID="$(jq -r --arg n "$SQUAD_NAME" 'first(.response.internalSquads[] | select(.name == $n) | .uuid) // empty' <<<"$RESP")"
  if [ -z "$SQUAD_UUID" ]; then
    say "Создаю группу $SQUAD_NAME"
    api_ok POST /api/internal-squads "$(jq -nc --arg n "$SQUAD_NAME" --arg i "$INBOUND_UUID" '{name: $n, inbounds: [$i]}')"
    return
  fi
  local inbounds
  inbounds="$(jq -c --arg n "$SQUAD_NAME" 'first(.response.internalSquads[] | select(.name == $n)) | [.inbounds[].uuid]' <<<"$RESP")"
  if ! jq -e --arg i "$INBOUND_UUID" 'index($i) != null' <<<"$inbounds" >/dev/null; then
    api_ok PATCH /api/internal-squads "$(jq -nc --arg u "$SQUAD_UUID" --arg i "$INBOUND_UUID" --argjson in "$inbounds" '{uuid: $u, inbounds: ($in + [$i])}')"
  fi
}

setup_subscription_settings() {
  api_ok GET /api/subscription-settings
  local body
  body="$(jq -c --arg support "${SUPPORT_URL:-}" --arg rule "$RULE_NAME" --arg sub "$SUB_DOMAIN" '.response
    | {
        # English defaults of the panel; replaced only while untouched.
        seed: {
          expiredUsers: ["⌛ Subscription expired", "Contact support"],
          limitedUsers: ["🚧 Subscription limited", "Contact support"],
          disabledUsers: ["🚫 Subscription disabled", "Contact support"],
          emptyHosts: ["→ Remnawave", "→ No hosts found", "→ Check Hosts tab", "→ Check Internal Squads tab"],
          HWIDMaxDevicesExceeded: ["Limit of devices reached"],
          HWIDNotSupported: ["App not supported"]
        },
        ru: {
          expiredUsers: ["Подписка закончилась", "Напишите тому, кто дал вам ссылку"],
          limitedUsers: ["Трафик по подписке закончился", "Напишите тому, кто дал вам ссылку"],
          disabledUsers: ["Подписка отключена", "Напишите тому, кто дал вам ссылку"],
          emptyHosts: ["Серверов пока нет", "Обновите подписку позже"],
          HWIDMaxDevicesExceeded: ["Достигнут лимит устройств"],
          HWIDNotSupported: ["Обновите приложение Klaus VPN"]
        },
        rule: {
          name: $rule,
          description: "Klaus VPN for Android: base64 list of links",
          enabled: true,
          operator: "AND",
          conditions: [{headerName: "user-agent", operator: "REGEX", value: "^KlausVPN/", caseSensitive: true}],
          responseType: "XRAY_BASE64",
          responseModifications: {ignoreServeJsonAtBaseSubscription: true}
        },
        cur: .
      }
    | .cur as $c | .rule as $r
    | {
        uuid: $c.uuid,
        # Random picks from comma lists would make the app reconnect on
        # every refresh.
        randomizeHosts: false,
        # support-url follows SUPPORT_URL; without it there is none (the
        # panel starts with a placeholder that leads nowhere). The app sends
        # block reports to klaus-report-url and looks for updates at
        # klaus-app-url.
        customResponseHeaders: (($c.customResponseHeaders // {})
          + {"profile-title": "Klaus VPN", "profile-update-interval": "1",
             "klaus-report-url": "https://\($sub)/klaus/report",
             "klaus-app-url": "https://\($sub)/app/version.json"}
          | if $support != "" then .["support-url"] = $support else del(.["support-url"]) end),
        customRemarks: (if $c.customRemarks == .seed then .ru else $c.customRemarks end),
        # Devices are recorded even while the limit is off (the panel
        # stores every valid x-hwid); "klaus-panel hwid-limit N" turns the
        # limit on later. Turning it on now would cut off app versions that
        # do not send x-hwid yet.
        hwidSettings: (($c.hwidSettings // {enabled: false, fallbackDeviceLimit: 999, maxDevicesAnnounce: null})
          | .maxDevicesAnnounce //= "Достигнут лимит устройств. Напишите тому, кто дал вам ссылку: он может удалить старое устройство."),
        # Our rule goes right after the browser rule, before the fallback.
        responseRules: (($c.responseRules // {version: "1", rules: []})
          | .rules |= (map(select(.name != $r.name))
            | (map(.responseType == "BROWSER") | index(true)) as $b
            | if $b == null then [$r] + . else .[:$b + 1] + [$r] + .[$b + 1:] end))
      }' <<<"$RESP")"
  api_ok PATCH /api/subscription-settings "$body"
}

setup_subpage() {
  api_ok GET /api/subscription-page-configs
  local uuid cfg apk="${APK_URL:-}"
  uuid="$(jq -r 'first((.response.configs[] | select(.uuid == "00000000-0000-0000-0000-000000000000")), .response.configs[0]) | .uuid // empty' <<<"$RESP")"
  [ -n "$uuid" ] || die "в панели нет настроек страницы подписки"
  api_ok GET "/api/subscription-page-configs/$uuid"
  # The app published on the subscription address, unless APK_URL says
  # otherwise.
  if [ -z "$apk" ] && [ -f "$APP_DIR/KlausVPN.apk" ]; then apk="https://$SUB_DOMAIN/app/KlausVPN.apk"; fi
  cfg="$(jq -c --arg apk "$apk" --arg support "${SUPPORT_URL:-}" --arg sub "$SUB_DOMAIN" --arg app "$APP_NAME" '.response.config
    | .locales as $locales
    # Every text needs every language of the page: Russian for ru,
    # English for the rest.
    | def t($ru; $en): reduce $locales[] as $l ({}; .[$l] = (if $l == "ru" then $ru else $en end));
    {
      name: $app, featured: true, svgIconKey: "KlausVPN",
      blocks: [
        {
          svgIconKey: "DownloadIcon", svgIconColor: "cyan",
          title: t("Установите приложение"; "Install the app"),
          # Samsung Auto Blocker and Huawei/Honor Pure mode refuse files
          # from the browser, which a first install always is.
          description: (if $apk != "" then
              t("Скачайте Klaus VPN и откройте файл. Если телефон спросит, разрешите установку из этого источника. Samsung, Huawei или Honor не дают поставить файл? На время выключите «Автоблокировщик» (Samsung) или «Чистый режим» (Huawei, Honor): их можно найти поиском в настройках.";
                "Download Klaus VPN and open the file. If asked, allow installing from this source. Samsung, Huawei or Honor refuse the file? Turn off Auto Blocker (Samsung) or Pure mode (Huawei, Honor) for a moment: search for it in Settings.")
            else
              t("Попросите файл Klaus VPN у того, кто дал вам эту ссылку, и установите его.";
                "Ask the person who gave you this link for the Klaus VPN file and install it.")
            end),
          buttons: (if $apk != "" then
              [{type: "external", link: $apk, text: t("Скачать приложение"; "Download the app"), svgIconKey: "DownloadIcon"}]
            else [] end)
        },
        {
          svgIconKey: "CloudDownload", svgIconColor: "cyan",
          title: t("Добавьте подписку"; "Add the subscription"),
          description: t("Нажмите кнопку: откроется Klaus VPN и предложит добавить подписку. Если ничего не произошло, скопируйте ссылку и вставьте её в приложении (кнопка «+»).";
            "Tap the button: Klaus VPN opens and offers to add the subscription. If nothing happens, copy the link and paste it in the app (the + button)."),
          buttons: [
            {type: "subscriptionLink", link: "klausvpn://add/{{SUBSCRIPTION_LINK}}",
              text: t("Добавить в Klaus VPN"; "Add to Klaus VPN"), svgIconKey: "Plus"},
            {type: "copyButton", link: "{{SUBSCRIPTION_LINK}}",
              text: t("Скопировать ссылку"; "Copy the link"), svgIconKey: "Copy"}
          ]
        },
        {
          svgIconKey: "Check", svgIconColor: "teal",
          title: t("Подключайтесь"; "Connect"),
          description: t("Нажмите большую кнопку в приложении. Список серверов обновляется сам.";
            "Tap the big button in the app. The server list updates by itself."),
          buttons: []
        }
      ]
    } as $klaus
    | .svgLibrary.KlausVPN = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg>"
    | .svgLibrary.Copy = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg>"
    | .brandingSettings.title = $app
    # The support button cannot be hidden (the panel wants a link here).
    # Without SUPPORT_URL it leads to a note on the subscription address
    # (Caddy answers it) instead of the placeholder of the panel.
    | .brandingSettings.supportUrl = (if $support != "" then $support else "https://\($sub)/" end)
    | .baseSettings.metaTitle = $app
    | .baseSettings.metaDescription = $app
    | .platforms.android //= {displayName: t("Android"; "Android"), svgIconKey: "Android", apps: []}
    # The other apps stay available, Klaus VPN comes first and is preselected.
    | .platforms.android.apps = [$klaus] + (.platforms.android.apps | map(select(.name != $app) | .featured = false))
  ' <<<"$RESP")"
  # Unchanged settings: no restart (friends' refreshes would fail meanwhile).
  [ "$(jq -S -c '.response.config' <<<"$RESP")" != "$(jq -S -c . <<<"$cfg")" ] || return 0
  api_ok PATCH /api/subscription-page-configs "$(jq -c --arg u "$uuid" '{uuid: $u, config: .}' <<<"$cfg")"
  # The page reads its settings only when it starts.
  if grep -qx remnawave-subscription-page <<<"$(docker ps --format '{{.Names}}' 2>/dev/null)"; then
    docker restart remnawave-subscription-page >/dev/null
  fi
}

# version.json names the APK with the subscription address: follow a new
# SUB_DOMAIN.
refresh_version_json() {
  [ -f "$APP_DIR/version.json" ] || return 0
