<?xml version="1.0" encoding="utf-8"?>
<!-- The upper panel while connected: green light spreading from the power
     button (right, about 40 dp from the edge) over the map. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <solid android:color="#08FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <gradient
                android:centerColor="#661A5028"
                android:centerX="0.87"
                android:centerY="0.5"
                android:endColor="#001A5028"
                android:gradientRadius="125%"
                android:startColor="#E61A5028"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <stroke android:width="1dp" android:color="#2400B800" />
        </shape>
    </item>
</layer-list>
