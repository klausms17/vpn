<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, one row high (4x1, 2x1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/power"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_power_on">

        <ImageView
            android:id="@+id/power_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_power_off" />

        <ImageView
            android:id="@+id/power_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_power" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/server_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_preview_server"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_status"
                android:textColor="@color/widget_text_soft"
                android:textSize="12sp" />

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ping_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_pill"
        android:contentDescription="@string/widget_ping_action"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:gravity="bottom"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bar1"
                android:layout_width="3dp"
                android:layout_height="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bar" />

            <ImageView
                android:id="@+id/bar2"
                android:layout_width="3dp"
                android:layout_height="7dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bar" />

            <ImageView
                android:id="@+id/bar3"
                android:layout_width="3dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bar" />

            <ImageView
                android:id="@+id/bar4"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/ping_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/widget_ping"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
