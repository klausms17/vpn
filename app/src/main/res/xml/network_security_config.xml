<?xml version="1.0" encoding="utf-8"?>
<!-- The Java network stack is not used for downloads (the Go core is), so
     cleartext stays forbidden and only system CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
