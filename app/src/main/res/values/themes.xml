<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the platform theme only sets the window
         background so there is no flash on start. The app is always dark
         (the approved design), whatever the system setting. -->
    <style name="Theme.KlausVPN" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
